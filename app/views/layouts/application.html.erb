<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>LEGO® Collection Tracker | John Willenborg</title>
    <meta name="description" content="An interactive full-stack LEGO® collection and parts inventory tracker built by John Willenborg. Features Ruby on Rails, Active Record caching, Rebrickable API integration, and real-time Hotwire Turbo Streams updates." />
    <meta name="keywords" content="LEGO Collection Tracker, John Willenborg, Ruby on Rails, Hotwire, Turbo Streams, Active Record, Rebrickable API, Tailwind CSS, SQLite, Full Stack Developer, Ruby Portfolio" />
    <meta name="author" content="John Willenborg" />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="LEGO® Collection Tracker | John Willenborg" />
    <meta property="og:description" content="Explore an interactive Ruby on Rails inventory tracker featuring live Rebrickable API set lookups, Active Record caching, and real-time Hotwire Turbo Streams progress tracking." />
    <meta property="og:url" content="https://lego.jpwillenborg.com" />
    <meta property="og:image" content="https://lego.jpwillenborg.com/lego-og-preview.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="canonical" href="https://lego.jpwillenborg.com" />
    <meta name="theme-color" content="#090d16" />

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-[#090d16] text-[#a0aec0] min-h-screen font-sans antialiased overflow-x-hidden">
    <div class="app-shell flex flex-col min-h-screen w-full max-w-full overflow-x-hidden box-border">

      <!-- GLOBAL NAVIGATION HEADER -->
      <% portfolio_url = ENV.fetch("PORTFOLIO_URL", "https://jpwillenborg.com") %>
      <% nav_links = [
        { href: "#{portfolio_url}/#top", label: "Overview" },
        { href: "#{portfolio_url}/#stacks", label: "Tech Stack" },
        { href: "#{portfolio_url}/#apps", label: "Web Apps" },
        { href: "#{portfolio_url}/#gamedev", label: "Game Dev" },
        { href: "#{portfolio_url}/#modeling", label: "3D Modeling" }
      ] %>

      <header data-controller="navbar">
        <nav aria-label="Main Navigation" class="fixed top-0 left-0 w-full z-50 py-[1.25rem] bg-[#06090f] border-b border-[#1a2333]/30 transition-colors duration-200 ease-in-out">
          <div class="max-w-[1280px] mx-auto px-4 sm:px-6">
            <div class="flex items-center justify-between w-full m-0">

              <!-- Branding Logo Block -->
              <div class="w-1/2 min-[1040px]:w-1/4 text-left">
                <a href="<%= "#{portfolio_url}/#top" %>" class="text-[1.75rem] font-bold text-white no-underline tracking-tight inline-block lowercase font-sans rounded-[4px] focus-ring">
                  john<span class="text-[#00e5ff]" aria-hidden="true">.</span>willenborg
                </a>
              </div>

              <!-- Desktop Menu Links -->
              <div class="hidden min-[1040px]:flex min-[1040px]:w-1/2 justify-center items-center">
                <div class="flex gap-[2.75rem]">
                  <% nav_links.each do |link| %>
                    <a href="<%= link[:href] %>" class="no-underline font-mono text-[#a0aec0] opacity-85 hover:text-[#00e5ff] hover:opacity-100 transition-all duration-200 text-[1.05rem] font-normal tracking-normal inline-block text-center rounded-[4px] focus-ring">
                      <%= link[:label] %>
                    </a>
                  <% end %>
                </div>
              </div>

              <!-- Contact CTA Link & Mobile Hamburger Toggle -->
              <div class="w-1/2 min-[1040px]:w-1/4 text-right flex justify-end items-center">
                <div class="hidden min-[1040px]:flex items-center">
                  <a href="<%= "#{portfolio_url}/#contact" %>" class="btn-primary py-[0.45rem] px-[1.25rem] text-[0.85rem] cursor-pointer focus-ring">
                    Let's Connect
                  </a>
                </div>
                <button
                  type="button"
                  data-navbar-target="button"
                  data-action="click->navbar#toggle"
                  class="bg-transparent border-0 outline-none p-0 min-[1040px]:hidden text-[1.75rem] no-underline cursor-pointer rounded-[4px] focus-ring"
                  aria-expanded="false"
                  aria-controls="lego-mobile-nav"
                  aria-label="Toggle mobile navigation menu"
                >
                  <span data-navbar-target="icon" class="text-[#a0aec0] opacity-85 hover:text-[#00e5ff] active:text-[#00e5ff] transition-all duration-200">☰</span>
                </button>
              </div>

            </div>
          </div>
        </nav>

        <!-- Full-Screen Mobile Navigation Overlay -->
        <div
          id="lego-mobile-nav"
          data-navbar-target="menu"
          aria-label="Mobile navigation"
          class="hidden fixed inset-0 w-full h-full z-40 flex-col justify-center items-start min-[1040px]:hidden bg-[#090d16] px-10 md:px-24 lg:px-32"
        >
          <div class="flex flex-col gap-5 md:gap-7 border-l border-white/[0.04] pl-6 md:pl-10 text-left">
            <% nav_links.each do |link| %>
              <a
                href="<%= link[:href] %>"
                data-action="click->navbar#close"
                class="no-underline text-white/90 font-mono font-medium text-[1.25rem] md:text-[2rem] lg:text-[2.5rem] tracking-wide hover:text-[#00e5ff] transition-colors"
              >
                <%= link[:label] %>
              </a>
            <% end %>
            <a
              href="<%= "#{portfolio_url}/#contact" %>"
              data-action="click->navbar#close"
              class="no-underline text-white/90 font-mono font-medium text-[1.25rem] md:text-[2rem] lg:text-[2.5rem] tracking-wide hover:text-[#00e5ff] transition-colors"
            >
              Let's Connect
            </a>
          </div>
        </div>
      </header>

      <div class="w-full box-border relative z-10 px-6 sm:px-8 md:px-[40px] lg:px-6 pt-[125px] md:pt-[140px] lg:pt-[160px] pb-16 md:pb-[80px] lg:pb-[140px] max-w-full overflow-x-hidden flex-grow flex flex-col justify-start">
        <main role="main" class="max-w-[1024px] mx-auto w-full box-border">
          <%= yield %>
        </main>
      </div>

      <footer class="w-full border-t border-[#1a2333]/70 bg-[#090d16] py-[0.75rem] px-4 md:px-16 mt-auto leading-normal flex-shrink-0 relative z-20 flex items-center">
        <div class="max-w-[1280px] mx-auto w-full flex flex-col items-center justify-center text-center gap-0.5 md:flex-row md:justify-between md:text-left font-mono text-[#a0aec0]/65 text-[0.75rem] md:text-[1.05rem] tracking-[0.25px]">
          <div>John Willenborg © 2026</div>
          <div>Built with Ruby on Rails + Tailwind + Hotwire</div>
        </div>
      </footer>

    </div>
  </body>
</html>
