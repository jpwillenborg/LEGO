<% # 1. Refresh the My Saved Sets sidebar list %>
<%= turbo_stream.replace "local-sets-list-container" do %>
  <div id="local-sets-list-container" class="flex flex-col gap-3 w-full box-border">
    <%= render "set_list", lego_sets: @lego_sets, selected_set: @selected_set %>
  </div>
<% end %>

<% # 2. Update the main workspace display panel in case the active set was deleted %>
<%= turbo_stream.replace "matrix-display-panel" do %>
  <div id="matrix-display-panel" class="lg:col-span-2 w-full portfolio-panel-card min-h-[520px] box-border" style="border: none !important;">
    <%= render "matrix_grid", selected_set: @selected_set, inventory_parts: @inventory_parts %>
  </div>
<% end %>
